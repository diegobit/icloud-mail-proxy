{
  "name": "icloud-mail-proxy",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "wrangler dev -c wrangler.base.jsonc",
    "deploy": "node scripts/deploy.mjs",
    "deploy:production": "node scripts/deploy.mjs --profile production",
    "config": "node scripts/deploy.mjs --print-config",
    "check:bundle": "wrangler deploy --dry-run -c wrangler.base.jsonc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "agents": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "postal-mime": "^2.7.5",
    "zod": "^4.0.0",
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "fast-xml-parser": "5.11.2",
    "ical.js": "2.2.1"
  },
  "devDependencies": {
    "wrangler": "^4",
    "typescript": "^5",
    "vitest": "^3",
    "@cloudflare/workers-types": "^4"
  },
  "overrides": {
    "@cloudflare/workers-types": "^4"
  }
}
