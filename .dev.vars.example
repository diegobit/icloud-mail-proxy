# Copy to .dev.vars (gitignored) for local `wrangler dev`
# Your full iCloud email address
ICLOUD_USER=you@icloud.com
# Apple app-specific password (appleid.apple.com → Sign-In and Security → App-Specific Passwords)
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Long random bearer token required on every request to this proxy
API_TOKEN=change-me
