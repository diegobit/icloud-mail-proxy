# Copy to .dev.vars (gitignored) for local `wrangler dev`
# Your full iCloud email address
ICLOUD_USER=you@icloud.com
# Apple app-specific password (appleid.apple.com → Sign-In and Security → App-Specific Passwords)
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Long random bearer token required on every request to this proxy
API_TOKEN=change-me
# Optional: the public origin when a tunnel or proxy hides the local one
# (a bare https origin, or http on loopback). Leave commented for normal runs.
# PUBLIC_ORIGIN=https://your-tunnel.trycloudflare.com
# Optional sending identity. SEND_FROM must be an address this iCloud account
# owns; it defaults to ICLOUD_USER.
# SEND_FROM=you@icloud.com
# SEND_FROM_NAME=Your Name
# Optional: append a copy of every sent message to "Sent Messages".
# SEND_SENT_COPY=0
# Optional but recommended: a credential for the approval page that agents do
# not hold. Without it the page accepts API_TOKEN, so an agent with shell
# access could approve its own drafts.
# SEND_APPROVAL_TOKEN=change-me
# Test-only: a loopback SMTP server for integration tests. Any other host is
# ignored (production always uses smtp.mail.me.com:587 with STARTTLS).
# SMTP_HOST=127.0.0.1
# SMTP_PORT=2525
