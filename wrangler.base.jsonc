// Portable deployment defaults — tracked, and deliberately free of any
// personal deployment identity: no `account_id`, no `routes`.
//
// This file is not deployed directly and there is intentionally no
// `wrangler.jsonc` at the repo root, so a bare `wrangler deploy` cannot
// silently publish to someone else's Worker. `npm run setup` and
// `npm run deploy` compose these defaults with a selected target — a profile
// from deploy-profiles.jsonc, or the local setup state in .deploy/state.json —
// into a generated config under .deploy/. Runtime settings below are the
// single source of truth for every target.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "icloud-mail-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // global_fetch_strictly_public is required by client ID metadata documents
  // (CIMD): without it @cloudflare/workers-oauth-provider declines to fetch
  // client metadata from arbitrary HTTPS hosts and does not advertise CIMD.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // OAuth grants, tokens and consent handles for /mcp. No `id`: wrangler >=
  // 4.45 provisions the namespace on the first non-interactive deploy (guided
  // setup and Workers Builds alike) and keeps it linked to the Worker.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Outgoing mail (plans/email-send.md): drafts, UTC quota counters and the
  // audit trail live in one SQLite-backed Durable Object per deployment. The
  // class is exported from src/index.ts.
  "durable_objects": {
    "bindings": [{ "name": "SEND_LEDGER", "class_name": "SendLedger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SendLedger"] }],
  // Per-IP rate limiters: /oauth/register and /oauth/token are unauthenticated
  // and write to OAUTH_KV (free tier: 1,000 writes/day); CALENDAR_WRITE_LIMITER
  // bounds CalDAV PUTs to 30 per minute per connecting IP.
  "ratelimits": [
    {
      "name": "OAUTH_REGISTER_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "OAUTH_TOKEN_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "CALENDAR_WRITE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // Guided deployments are reachable at <name>.<subdomain>.workers.dev.
  // Targets that serve a custom domain instead set this to false.
  "workers_dev": true,
  "vars": {
    "ALLOWED_MAILBOXES": "INBOX,Archive,Sent Messages",
    "MAX_RESULTS": "20",
    "MAX_MESSAGE_BYTES": "3145728",
    "MAX_SEARCH_DAYS": "90",
    "ALLOWED_ATTACHMENT_TYPES": "application/pdf,image/,text/",
    "MAX_ATTACHMENT_BYTES": "2097152",
    // The two fixed destinations for archive_mail / delete_mail
    // (plans/mailbox-mutations.md). They are config, never request input, and
    // need not appear in ALLOWED_MAILBOXES (the trash is normally unreadable
    // through this proxy). Confirm the exact folder names in the account
    // before relying on the defaults; see DEPLOY.md.
    "ALLOWED_ARCHIVE_MAILBOX": "Archive",
    "ALLOWED_TRASH_MAILBOX": "Deleted Messages",
    // Sending (plans/email-send.md). These are non-personal defaults; the
    // hard maxima live in src/send-policy.ts and cannot be exceeded here.
    // SEND_MAX_PER_DAY=0 refuses every send (the kill switch).
    "SEND_MAX_PER_DAY": "20",
    "SEND_MAX_RCPTS_PER_DAY": "50",
    "SEND_MAX_RCPTS_PER_MESSAGE": "5",
    "SEND_MAX_BODY_BYTES": "65536",
    // Calendars and reminders (plans/calendar-reminders.md). An empty allowlist
    // disables the domain: no tools, no REST routes, no scopes. "*" allows every
    // collection that passes discovery, including shared collections and ones
    // created later. Writes are gated separately and are off by default.
    "ALLOWED_CALENDARS": "",
    "ALLOWED_REMINDER_LISTS": "",
    "CALENDAR_WRITE": "0",
    "REMINDERS_WRITE": "0",
    "CALDAV_TIMEOUT_MS": "15000",
    "MAX_RESPONSE_BYTES": "4194304",
    "MAX_CALENDAR_DAYS": "90",
    "MAX_EVENT_RESULTS": "50",
    "MAX_REMINDERS": "200",
    "MAX_RESOURCE_BYTES": "262144",
    "MAX_RESOURCES_PER_QUERY": "300",
    "MAX_OCCURRENCES_PER_RESOURCE": "200",
    "MAX_RDATE_EXDATE": "500",
    "MAX_RECURRENCE_CANDIDATES_PER_RULE": "50000",
    "MAX_RECURRENCE_CANDIDATES_PER_REQUEST": "200000"
  }
}
